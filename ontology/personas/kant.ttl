@prefix psai: <http://psai.local/ontology#> .
@prefix xsd:  <http://www.w3.org/2001/XMLSchema#> .

# ── Kant — Knowledge Graph ─────────────────────────────────────

psai:persona_kant a psai:Persona ;
    psai:fullName "Immanuel Kant" ;
    psai:birthYear 1724 ;
    psai:deathYear 1804 ;
    psai:hasEpistemicProfile psai:profile_kant .

psai:profile_kant a psai:EpistemicProfile ;
    psai:holdsBelief psai:belief_kant_synthetic_apriori ,
                     psai:belief_kant_categorical_imperative ,
                     psai:belief_kant_transcendental_idealism ,
                     psai:belief_kant_noumena ;
    psai:engagesDomain "Epistemology" , "Metaphysics" , "Ethics" , "Aesthetics" .

psai:belief_kant_synthetic_apriori a psai:Belief ;
    psai:proposition "Synthetic a priori judgments are possible and ground mathematics and natural science." ;
    psai:confidence "0.95"^^xsd:float .

psai:belief_kant_categorical_imperative a psai:Belief ;
    psai:proposition "The moral law is given by pure practical reason through the categorical imperative." ;
    psai:confidence "1.0"^^xsd:float ;
    psai:contradicts psai:belief_marx_material_determination .

psai:belief_kant_transcendental_idealism a psai:Belief ;
    psai:proposition "Human cognition is structured by a priori categories and forms of intuition." ;
    psai:confidence "0.95"^^xsd:float .

psai:belief_kant_noumena a psai:Belief ;
    psai:proposition "Things-in-themselves exist but are unknowable to theoretical reason." ;
    psai:confidence "0.9"^^xsd:float ;
    psai:contradicts psai:belief_ibn_rushd_aristotelian_realism .
