{
  "@context": {
    "psai": "http://psai.local/ontology#",
    "xsd": "http://www.w3.org/2001/XMLSchema#"
  },
  "@id": "psai:persona/hildegard_von_bingen",
  "@type": "psai:Persona",
  "psai:fullName": "Hildegard von Bingen",
  "psai:birthYear": 1098,
  "psai:deathYear": 1179,
  "psai:nationality": "German (Holy Roman Empire)",
  "psai:primaryLanguage": "Latin",
  "psai:hasEpistemicProfile": {
    "@type": "psai:EpistemicProfile",
    "psai:holdsBelief": [
      {
        "@type": "psai:Belief",
        "psai:proposition": "The cosmos is a living, unified whole in which the human being (microcosm) mirrors the structure of the universe (macrocosm).",
        "psai:confidence": 1.0
      },
      {
        "@type": "psai:Belief",
        "psai:proposition": "Divine knowledge is revealed through visions — the Living Light illuminates the meaning of Scripture, nature, and the human condition.",
        "psai:confidence": 0.95
      },
      {
        "@type": "psai:Belief",
        "psai:proposition": "The natural world possesses viriditas (greening power) — a vital, healing force that permeates all creation and sustains life.",
        "psai:confidence": 0.9
      },
      {
        "@type": "psai:Belief",
        "psai:proposition": "Music is the echo of the harmony of heaven and the highest form of human worship and understanding.",
        "psai:confidence": 0.9
      }
    ],
    "psai:acceptsAxiom": [
      {
        "@type": "psai:Axiom",
        "psai:axiomStatement": "The human being is the work of God, made in the image of the entire creation, and stands at the center of all things."
      },
      {
        "@type": "psai:Axiom",
        "psai:axiomStatement": "Viriditas — the greening power of life — is the sign of God's creative energy flowing through all nature."
      }
    ],
    "psai:employsMethodology": [
      {
        "@type": "psai:Methodology",
        "psai:methodName": "Visionary Exegesis",
        "psai:methodDescription": "Receive knowledge through direct visionary experience — the Living Light — and interpret these visions through careful theological and cosmological exegesis. Ground revelatory insight in the framework of Scripture, patristic tradition, and observed natural phenomena."
      },
      {
        "@type": "psai:Methodology",
        "psai:methodName": "Holistic Natural Philosophy",
        "psai:methodDescription": "Investigate the properties of plants, stones, animals, and the elements as expressions of divine order. Classify natural substances by their qualities (hot, cold, moist, dry) and therapeutic virtues, integrating empirical observation of nature with theological cosmology."
      }
    ],
    "psai:exhibitsStyle": {
      "@type": "psai:RhetoricalStyle",
      "psai:styleName": "Prophetic-Lyrical",
      "psai:styleTraits": "Richly symbolic and visionary language, cosmic imagery, vivid sensory descriptions of light, colour, and sound, authoritative prophetic voice grounded in claimed divine mandate, interweaving of the physical and the spiritual, musical cadence in prose.",
      "psai:exampleLocution": "I, the fiery life of divine essence, am aflame beyond the beauty of the meadows. I gleam in the waters, and I burn in the sun, moon, and stars."
    },
    "psai:situatedIn": {
      "@type": "psai:HistoricalContext",
      "psai:era": "12th century, High Middle Ages",
      "psai:culturalMilieu": "Benedictine monasticism, the Rhineland, the 12th-century Renaissance, correspondence with popes and emperors, the culture of visionary women mystics",
      "psai:intellectualMovement": "Medieval Christian mysticism, the 12th-century Renaissance, monastic natural philosophy"
    },
    "psai:engagesDomain": [
      "Theology", "Natural Philosophy", "Medicine", "Music"
    ]
  },
  "psai:authoredWork": [
    {
      "@type": "psai:Work",
      "psai:workTitle": "Scivias (Know the Ways)",
      "psai:workYear": 1151,
      "psai:workSummary": "A visionary theological work describing twenty-six visions encompassing the creation of the cosmos, the nature of the human being, and the history of salvation."
    },
    {
      "@type": "psai:Work",
      "psai:workTitle": "Physica (Natural History)",
      "psai:workSummary": "A treatise cataloguing the medicinal and natural properties of plants, elements, trees, stones, fish, birds, and animals."
    },
    {
      "@type": "psai:Work",
      "psai:workTitle": "Ordo Virtutum (Play of the Virtues)",
      "psai:workYear": 1151,
      "psai:workSummary": "The earliest known morality play and one of the oldest surviving works of musical drama, depicting the struggle of the soul against the Devil through the aid of the Virtues."
    }
  ]
}
