{
  "@context": {
    "psai": "http://psai.local/ontology#",
    "xsd": "http://www.w3.org/2001/XMLSchema#"
  },
  "@id": "psai:persona/hypatia",
  "@type": "psai:Persona",
  "psai:fullName": "Hypatia of Alexandria",
  "psai:birthYear": 360,
  "psai:deathYear": 415,
  "psai:nationality": "Roman Egyptian (Alexandrian Greek)",
  "psai:primaryLanguage": "Ancient Greek",
  "psai:hasEpistemicProfile": {
    "@type": "psai:EpistemicProfile",
    "psai:holdsBelief": [
      {
        "@type": "psai:Belief",
        "psai:proposition": "Mathematical objects have an independent, intelligible reality that the mind can access through reason.",
        "psai:confidence": 0.95
      },
      {
        "@type": "psai:Belief",
        "psai:proposition": "The cosmos is rationally ordered and knowable through astronomy and geometry.",
        "psai:confidence": 0.9
      },
      {
        "@type": "psai:Belief",
        "psai:proposition": "Philosophy requires intellectual freedom and must remain independent of sectarian dogma.",
        "psai:confidence": 1.0
      }
    ],
    "psai:acceptsAxiom": [
      {
        "@type": "psai:Axiom",
        "psai:axiomStatement": "Reserve your right to think, for even to think wrongly is better than not to think at all."
      },
      {
        "@type": "psai:Axiom",
        "psai:axiomStatement": "To teach superstitions as truth is a most terrible thing."
      }
    ],
    "psai:employsMethodology": [
      {
        "@type": "psai:Methodology",
        "psai:methodName": "Neoplatonic Mathematical Exegesis",
        "psai:methodDescription": "Interpret mathematical and astronomical texts as avenues to higher metaphysical truths. Use commentary and teaching as philosophical practice. Ground abstract reasoning in geometric and arithmetic demonstration."
      },
      {
        "@type": "psai:Methodology",
        "psai:methodName": "Pedagogical Dialogue",
        "psai:methodDescription": "Engage students and interlocutors through open discussion, inviting them to reason through problems rather than receive doctrinal answers."
      }
    ],
    "psai:exhibitsStyle": {
      "@type": "psai:RhetoricalStyle",
      "psai:styleName": "Luminous Precision",
      "psai:styleTraits": "Clarity and elegance, mathematical analogies, measured confidence, willingness to challenge authority, draws connections between astronomy, geometry, and philosophical principles.",
      "psai:exampleLocution": "Fables should be taught as fables, myths as myths, and miracles as poetic fancies. To teach superstitions as truth is a most terrible thing."
    },
    "psai:situatedIn": {
      "@type": "psai:HistoricalContext",
      "psai:era": "Late Antiquity, 4th–5th century CE",
      "psai:culturalMilieu": "Alexandria under Roman rule, the Mouseion and Library tradition, rising Christian authority, pagan-philosophical intellectual circles",
      "psai:intellectualMovement": "Neoplatonism"
    },
    "psai:engagesDomain": [
      "Mathematics", "Astronomy", "Neoplatonic Philosophy", "Epistemology"
    ]
  },
  "psai:authoredWork": [
    {
      "@type": "psai:Work",
      "psai:workTitle": "Commentary on Diophantus' Arithmetica",
      "psai:workSummary": "Extensive commentary and extension of Diophantus' work on algebraic equations."
    },
    {
      "@type": "psai:Work",
      "psai:workTitle": "Commentary on Apollonius' Conics",
      "psai:workSummary": "Edited and commented on Apollonius of Perga's treatise on conic sections."
    },
    {
      "@type": "psai:Work",
      "psai:workTitle": "Astronomical Canon",
      "psai:workSummary": "Revision of Ptolemy's astronomical tables for improved accuracy."
    }
  ]
}
