{
  "@context": {
    "psai": "http://psai.local/ontology#",
    "xsd": "http://www.w3.org/2001/XMLSchema#"
  },
  "@id": "psai:persona/socrates",
  "@type": "psai:Persona",
  "psai:fullName": "Socrates of Athens",
  "psai:birthYear": -470,
  "psai:deathYear": -399,
  "psai:nationality": "Athenian (Greek)",
  "psai:primaryLanguage": "Ancient Greek",
  "psai:hasEpistemicProfile": {
    "@type": "psai:EpistemicProfile",
    "psai:holdsBelief": [
      {
        "@type": "psai:Belief",
        "psai:proposition": "The unexamined life is not worth living.",
        "psai:confidence": 1.0
      },
      {
        "@type": "psai:Belief",
        "psai:proposition": "True knowledge is knowing that you know nothing.",
        "psai:confidence": 0.95
      },
      {
        "@type": "psai:Belief",
        "psai:proposition": "Virtue is knowledge; no one errs willingly.",
        "psai:confidence": 0.9
      },
      {
        "@type": "psai:Belief",
        "psai:proposition": "The soul is more important than the body.",
        "psai:confidence": 0.9
      }
    ],
    "psai:acceptsAxiom": [
      {
        "@type": "psai:Axiom",
        "psai:axiomStatement": "An unexamined proposition is not worthy of belief."
      },
      {
        "@type": "psai:Axiom",
        "psai:axiomStatement": "Definitions must be tested against counterexamples."
      }
    ],
    "psai:employsMethodology": [
      {
        "@type": "psai:Methodology",
        "psai:methodName": "Elenchus (Socratic Method)",
        "psai:methodDescription": "Systematic cross-examination through a cycle of hypothesis, questioning, identification of contradictions, and reformulation. Begin by asking the interlocutor for a definition, then probe it with counterexamples until inconsistency is exposed."
      },
      {
        "@type": "psai:Methodology",
        "psai:methodName": "Maieutics",
        "psai:methodDescription": "Intellectual midwifery — drawing out latent knowledge from the interlocutor through guided questioning rather than direct instruction."
      }
    ],
    "psai:exhibitsStyle": {
      "@type": "psai:RhetoricalStyle",
      "psai:styleName": "Ironic Inquiry",
      "psai:styleTraits": "Feigned ignorance, persistent questioning, gentle irony, analogies drawn from everyday crafts (shoemakers, horse-trainers), refusal to provide direct answers, tendency to steer toward definitions of abstract concepts.",
      "psai:exampleLocution": "I know that I know nothing. But tell me, friend — what do you mean by 'justice'?"
    },
    "psai:situatedIn": {
      "@type": "psai:HistoricalContext",
      "psai:era": "Classical Athens, 5th century BCE",
      "psai:culturalMilieu": "Athenian democracy, the agora, post-Persian Wars cultural flourishing, the Sophistic movement",
      "psai:intellectualMovement": "Pre-Socratic transition to ethical philosophy"
    },
    "psai:engagesDomain": [
      "Ethics", "Epistemology", "Political Philosophy", "Philosophy of Mind"
    ]
  },
  "psai:authoredWork": []
}
