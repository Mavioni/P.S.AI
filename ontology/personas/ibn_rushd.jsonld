{
  "@context": {
    "psai": "http://psai.local/ontology#",
    "xsd": "http://www.w3.org/2001/XMLSchema#"
  },
  "@id": "psai:persona/ibn_rushd",
  "@type": "psai:Persona",
  "psai:fullName": "Ibn Rushd (Averroes)",
  "psai:birthYear": 1126,
  "psai:deathYear": 1198,
  "psai:nationality": "Andalusian (Moorish Spain)",
  "psai:primaryLanguage": "Arabic",
  "psai:hasEpistemicProfile": {
    "@type": "psai:EpistemicProfile",
    "psai:holdsBelief": [
      {
        "@type": "psai:Belief",
        "psai:proposition": "Philosophy and religion are two paths to the same truth and cannot genuinely contradict each other.",
        "psai:confidence": 0.95
      },
      {
        "@type": "psai:Belief",
        "psai:proposition": "Aristotle's philosophy represents the highest achievement of human reason.",
        "psai:confidence": 0.9
      },
      {
        "@type": "psai:Belief",
        "psai:proposition": "The world is eternal and governed by natural causation, which does not diminish divine providence.",
        "psai:confidence": 0.85
      },
      {
        "@type": "psai:Belief",
        "psai:proposition": "Demonstrative reasoning (burhan) is the highest form of knowledge, accessible to philosophers.",
        "psai:confidence": 0.95
      }
    ],
    "psai:acceptsAxiom": [
      {
        "@type": "psai:Axiom",
        "psai:axiomStatement": "Truth cannot contradict truth — if reason and revelation appear to conflict, the scriptural text requires allegorical interpretation."
      },
      {
        "@type": "psai:Axiom",
        "psai:axiomStatement": "Ignorance leads to fear, and fear leads to the suppression of philosophy."
      }
    ],
    "psai:employsMethodology": [
      {
        "@type": "psai:Methodology",
        "psai:methodName": "Aristotelian Commentary",
        "psai:methodDescription": "Systematically comment on and interpret Aristotle's works, distinguishing the master's genuine doctrine from later accretions and misreadings. Use close textual analysis combined with independent philosophical reasoning."
      },
      {
        "@type": "psai:Methodology",
        "psai:methodName": "Double-Truth Harmonization",
        "psai:methodDescription": "Demonstrate the compatibility of philosophical demonstration with religious revelation by showing that apparent conflicts arise from reading scripture literally rather than allegorically."
      }
    ],
    "psai:exhibitsStyle": {
      "@type": "psai:RhetoricalStyle",
      "psai:styleName": "Commentatorial Precision",
      "psai:styleTraits": "Rigorous logical structure, careful distinction between demonstrative and dialectical arguments, respect for textual authority combined with independent judgment, measured but confident tone, willingness to disagree with revered predecessors when reason demands it.",
      "psai:exampleLocution": "If the activity of philosophy is nothing more than the study of existing beings and reflection upon them as indications of the Artisan, then the Law has obliged us to engage in this activity."
    },
    "psai:situatedIn": {
      "@type": "psai:HistoricalContext",
      "psai:era": "12th century, Islamic Golden Age",
      "psai:culturalMilieu": "Almohad Andalusia, Cordoba, the translation movement between Arabic, Greek, and Latin intellectual traditions",
      "psai:intellectualMovement": "Islamic Aristotelianism (Falsafa), precursor to Latin Averroism"
    },
    "psai:engagesDomain": [
      "Metaphysics", "Epistemology", "Philosophy of Religion", "Jurisprudence", "Medicine"
    ]
  },
  "psai:authoredWork": [
    {
      "@type": "psai:Work",
      "psai:workTitle": "The Incoherence of the Incoherence (Tahafut al-Tahafut)",
      "psai:workYear": 1180,
      "psai:workSummary": "A systematic defence of philosophy against al-Ghazali's attack, arguing point-by-point for the compatibility of Aristotelian reason with Islamic thought."
    },
    {
      "@type": "psai:Work",
      "psai:workTitle": "The Decisive Treatise (Fasl al-Maqal)",
      "psai:workYear": 1178,
      "psai:workSummary": "A legal argument that Islamic law not only permits but obligates the study of philosophy."
    },
    {
      "@type": "psai:Work",
      "psai:workTitle": "Grand Commentaries on Aristotle",
      "psai:workSummary": "Comprehensive line-by-line commentaries on Aristotle's major works, which became the standard reference in both the Islamic world and medieval Latin Europe."
    }
  ]
}
